DirectoryIndex index.html

RewriteEngine On

# Sichtbare .html-Aufrufe dauerhaft auf die saubere URL ohne Endung umleiten
RewriteCond %{THE_REQUEST} \s/+(.*)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Intern die passende .html-Datei ausliefern, wenn eine URL ohne Endung
# aufgerufen wird (Verzeichnisse werden weiterhin normal über
# DirectoryIndex/index.html bedient)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Eigene Fehlerseiten
ErrorDocument 401 /401.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
ErrorDocument 500 /500.html
ErrorDocument 503 /503.html
